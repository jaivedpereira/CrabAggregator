{
  "name": "crabaggregator",
  "version": "0.1.0",
  "description": "Universal, modular media aggregator CLI — music, books, manga and videos via pluggable Recipes.",
  "type": "module",
  "bin": {
    "crab": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cli",
    "media",
    "aggregator",
    "termux",
    "mpv",
    "yt-dlp",
    "plugins"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "axios": "^1.7.7",
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
